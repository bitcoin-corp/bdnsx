# bDNSX lease service. Copy to .env.local (gitignored). Never commit real values.

# Vault signing key (WIF). Read only at runtime, when a record is signed. Leave empty in files you share.
BDNSX_VAULT_WIF=
# Vault identity public key (compressed hex). Public. Resolver returns it for owner-held names,
# and the service refuses to sign if BDNSX_VAULT_WIF does not match it.
BDNSX_VAULT_PUBKEY=
# Store payment address that rent must be paid to.
BDNSX_PAY_TO=
# Owner public key (hex) allowed to sign revocations. Empty = revoke disabled.
BDNSX_OWNER_PUBKEY=

# 1 = fund + broadcast record txs via WhatsOnChain. Anything else = dry-run (default).
BDNSX_BROADCAST=0
# Optional separate funding key for record tx fees (WIF). Empty = vault key pays fees
# (UTXOs under 1000 sats are skipped so 1-sat name ordinals are never spent).
BDNSX_FUNDING_WIF=
# main | test
BDNSX_NETWORK=main

# Newline list of names the vault holds (e.g. exported from `bwalletx opns status`).
BDNSX_VAULT_NAMES_FILE=
# Newline list of names never leased (brands, KEEP list).
BDNSX_NOT_FOR_LEASE_FILE=
# JSON cache file (until the Supabase store is wired). Empty = in memory only.
BDNSX_CACHE_FILE=
# Optional override for config/pricing.json (absolute path).
BDNSX_PRICING_FILE=
# Owned (sold) names counted toward the adoption multiplier, in addition to active leases.
BDNSX_OWNED_NAMES_COUNT=0
# Confirmations required on the rent payment (0 = accept from mempool).
BDNSX_MIN_CONFIRMATIONS=0

PORT=8787
